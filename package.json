{
  "name": "cwf",
  "version": "0.1.0",
  "description": "Takes a Jira issue to a pull request with GitHub Copilot.",
  "type": "module",
  "bin": {
    "cwf": "./bin/cwf",
    "wt": "./scripts/wt.mjs"
  },
  "scripts": {
